<Application x:Class="WaddleFree.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#16161A"/>
        <SolidColorBrush x:Key="TileBackgroundBrush" Color="#222228"/>
        <SolidColorBrush x:Key="TileHoverBackgroundBrush" Color="#2C2C35"/>
        <SolidColorBrush x:Key="TileBorderBrush" Color="#45FFFFFF"/>
        <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#24242B"/>
        <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#1D1D23"/>
        <SolidColorBrush x:Key="FaqAnswerBackgroundBrush" Color="#141418"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FAFAFC"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#DBDDE4"/>
        <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentSubtleBrush" Color="#420078D4"/>
        <SolidColorBrush x:Key="AccentBorderBrush" Color="#AA0078D4"/>
        <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF"/>

        <!-- Dynamic Typography & UI Scale Tokens -->
        <sys:Double x:Key="FontSizeTitle">16.5</sys:Double>
        <sys:Double x:Key="FontSizeTileHeader">13.5</sys:Double>
        <sys:Double x:Key="FontSizeTileValue">22.0</sys:Double>
        <sys:Double x:Key="FontSizeBody">13.5</sys:Double>
        <sys:Double x:Key="FontSizeSmall">12.5</sys:Double>
        <sys:Double x:Key="FontSizeTiny">11.0</sys:Double>
        <FontWeight x:Key="BodyFontWeight">Normal</FontWeight>

        <sys:Double x:Key="IconButtonSize">40.0</sys:Double>
        <sys:Double x:Key="IconInnerSize">18.0</sys:Double>
        <sys:Double x:Key="GuideBadgeSize">22.0</sys:Double>
        <sys:Double x:Key="TButtonWidth">34.0</sys:Double>
        <sys:Double x:Key="TButtonHeight">30.0</sys:Double>
        <sys:Double x:Key="TIconSize">21.0</sys:Double>
        <sys:Double x:Key="PortIconSize">18.0</sys:Double>
        <CornerRadius x:Key="PortIconCornerRadius">9</CornerRadius>
        <sys:Double x:Key="MenuDividerHeight">18.0</sys:Double>
        <sys:Double x:Key="TileMinHeight">130.0</sys:Double>
        <sys:Double x:Key="TileMaxHeight">175.0</sys:Double>
        <sys:Double x:Key="SquircleSize">36.0</sys:Double>
        <CornerRadius x:Key="SquircleCornerRadius">11</CornerRadius>

        <!-- Global Sleek Windows 11 Slim ScrollBar Style (applies to all windows and popups) -->
        <Style TargetType="{x:Type Thumb}" x:Key="SlimScrollThumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource SecondaryTextBrush}"
                                Opacity="0.45"
                                CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent" Margin="4,2,4,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="MinWidth" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent" Margin="2,4,0,4">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
