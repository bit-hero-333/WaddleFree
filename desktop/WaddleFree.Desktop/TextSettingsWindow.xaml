<Window x:Class="WaddleFree.Desktop.TextSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme &amp; Appearance"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="495"
        Height="640"
        MinWidth="410"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized">

    <Window.Resources>
        <Style x:Key="OptionPillStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Squircle Button Style: Background (solid or ImageBrush) is painted directly inside the rounded Border -->
        <Style x:Key="ColorSquircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource SquircleSize}"/>
            <Setter Property="Height" Value="{DynamicResource SquircleSize}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SquircleOuter"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="{DynamicResource SquircleCornerRadius}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SquircleOuter" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,18">

            <TextBlock Text="Theme &amp; Appearance"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,12"/>

            <!-- 1. Named Theme Presets (Names & Palettes adapt dynamically to Dark vs Light mode) -->
            <Border Background="{DynamicResource TileBackgroundBrush}"
                    BorderBrush="{DynamicResource TileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Theme Presets"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PresetModeLabel"
                                   Text="Dark Mode Palettes"
                                   FontSize="{DynamicResource FontSizeTiny}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="10" Padding="3">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="PresetDefaultBtn"
                                    Content="Default"
                                    Tag="Default"
                                    Style="{StaticResource OptionPillStyle}"
                                    Click="PresetBtn_Click"/>
                            <Button x:Name="PresetOledBtn"
                                    Content="OLED"
                                    Tag="OLED"
                                    Style="{StaticResource OptionPillStyle}"
                                    Click="PresetBtn_Click"/>
                            <Button x:Name="PresetOceanBtn"
                                    Content="Midnight"
                                    Tag="Ocean"
                                    Style="{StaticResource OptionPillStyle}"
                                    Click="PresetBtn_Click"/>
                            <Button x:Name="PresetAmethystBtn"
                                    Content="Amethyst"
                                    Tag="Amethyst"
                                    Style="{StaticResource OptionPillStyle}"
                                    Click="PresetBtn_Click"/>
                            <Button x:Name="PresetEmeraldBtn"
                                    Content="Emerald"
                                    Tag="Emerald"
                                    Style="{StaticResource OptionPillStyle}"
                                    Click="PresetBtn_Click"/>
                            <Button x:Name="PresetEmberBtn"
                                    Content="Ember"
                                    Tag="Ember"
                                    Style="{StaticResource OptionPillStyle}"
                                    Click="PresetBtn_Click"/>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. Accent & Highlight Color -->
            <Border Background="{DynamicResource TileBackgroundBrush}"
                    BorderBrush="{DynamicResource TileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="0,0,0,10">
                <StackPanel x:Name="AccentSectionHost">
                    <TextBlock Text="Accent &amp; Highlight Color"
                               FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,9"/>

                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="AccentSquircle1" Style="{StaticResource ColorSquircleButtonStyle}" Background="#38BDF8" Tag="#38BDF8" Click="AccentPresetSquircle_Click"/>
                        <Button x:Name="AccentSquircle2" Style="{StaticResource ColorSquircleButtonStyle}" Background="#A855F7" Tag="#A855F7" Click="AccentPresetSquircle_Click"/>
                        <Button x:Name="AccentSquircle3" Style="{StaticResource ColorSquircleButtonStyle}" Background="#10B981" Tag="#10B981" Click="AccentPresetSquircle_Click"/>
                        <Button x:Name="AccentSquircle4" Style="{StaticResource ColorSquircleButtonStyle}" Background="#F97316" Tag="#F97316" Click="AccentPresetSquircle_Click"/>
                        <Button x:Name="AccentSquircle5" Style="{StaticResource ColorSquircleButtonStyle}" Background="#F43F5E" Tag="#F43F5E" Click="AccentPresetSquircle_Click"/>
                        <Button x:Name="AccentWheelSquircle" Style="{StaticResource ColorSquircleButtonStyle}" Margin="0" Click="AccentWheelSquircle_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 3. Window Background & Card Surface Colors -->
            <Border Background="{DynamicResource TileBackgroundBrush}"
                    BorderBrush="{DynamicResource TileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel x:Name="WinBgSectionHost" Margin="0,0,0,12">
                        <TextBlock Text="Window Background Color"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,9"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="WinBgSquircle1" Style="{StaticResource ColorSquircleButtonStyle}" Background="#16161A" Tag="#16161A" Click="WinBgPresetSquircle_Click"/>
                            <Button x:Name="WinBgSquircle2" Style="{StaticResource ColorSquircleButtonStyle}" Background="#0F172A" Tag="#0F172A" Click="WinBgPresetSquircle_Click"/>
                            <Button x:Name="WinBgSquircle3" Style="{StaticResource ColorSquircleButtonStyle}" Background="#161124" Tag="#161124" Click="WinBgPresetSquircle_Click"/>
                            <Button x:Name="WinBgSquircle4" Style="{StaticResource ColorSquircleButtonStyle}" Background="#F3F4F7" Tag="#F3F4F7" Click="WinBgPresetSquircle_Click"/>
                            <Button x:Name="WinBgSquircle5" Style="{StaticResource ColorSquircleButtonStyle}" Background="#FDF5EC" Tag="#FDF5EC" Click="WinBgPresetSquircle_Click"/>
                            <Button x:Name="WinBgWheelSquircle" Style="{StaticResource ColorSquircleButtonStyle}" Margin="0" Click="WinBgWheelSquircle_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel x:Name="TileBgSectionHost">
                        <TextBlock Text="Card &amp; Menu Surface Color"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,9"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="TileBgSquircle1" Style="{StaticResource ColorSquircleButtonStyle}" Background="#222228" Tag="#222228" Click="TileBgPresetSquircle_Click"/>
                            <Button x:Name="TileBgSquircle2" Style="{StaticResource ColorSquircleButtonStyle}" Background="#1E293B" Tag="#1E293B" Click="TileBgPresetSquircle_Click"/>
                            <Button x:Name="TileBgSquircle3" Style="{StaticResource ColorSquircleButtonStyle}" Background="#231B38" Tag="#231B38" Click="TileBgPresetSquircle_Click"/>
                            <Button x:Name="TileBgSquircle4" Style="{StaticResource ColorSquircleButtonStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="TileBgPresetSquircle_Click"/>
                            <Button x:Name="TileBgSquircle5" Style="{StaticResource ColorSquircleButtonStyle}" Background="#F8FAFC" Tag="#F8FAFC" Click="TileBgPresetSquircle_Click"/>
                            <Button x:Name="TileBgWheelSquircle" Style="{StaticResource ColorSquircleButtonStyle}" Margin="0" Click="TileBgWheelSquircle_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. Primary Text Color (5 Preset Basic Color Squircles + 6th Color Wheel Squircle) -->
            <Border Background="{DynamicResource TileBackgroundBrush}"
                    BorderBrush="{DynamicResource TileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="0,0,0,10">
                <StackPanel x:Name="PrimSectionHost">
                    <TextBlock Text="Main Heading &amp; Value Text Color"
                               FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,9"/>

                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="PrimSquircle1" Style="{StaticResource ColorSquircleButtonStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="PrimPresetSquircle_Click"/>
                        <Button x:Name="PrimSquircle2" Style="{StaticResource ColorSquircleButtonStyle}" Background="#18181B" Tag="#18181B" Click="PrimPresetSquircle_Click"/>
                        <Button x:Name="PrimSquircle3" Style="{StaticResource ColorSquircleButtonStyle}" Background="#F87171" Tag="#F87171" Click="PrimPresetSquircle_Click"/>
                        <Button x:Name="PrimSquircle4" Style="{StaticResource ColorSquircleButtonStyle}" Background="#4ADE80" Tag="#4ADE80" Click="PrimPresetSquircle_Click"/>
                        <Button x:Name="PrimSquircle5" Style="{StaticResource ColorSquircleButtonStyle}" Background="#60A5FA" Tag="#60A5FA" Click="PrimPresetSquircle_Click"/>
                        <Button x:Name="PrimWheelSquircle" Style="{StaticResource ColorSquircleButtonStyle}" Margin="0" Click="PrimWheelSquircle_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 5. Secondary / Body Text Color (5 Preset Basic Color Squircles + 6th Color Wheel Squircle) -->
            <Border Background="{DynamicResource TileBackgroundBrush}"
                    BorderBrush="{DynamicResource TileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="0,0,0,10">
                <StackPanel x:Name="SecSectionHost">
                    <TextBlock Text="Descriptions, FAQ Answers &amp; Hint Text Color"
                               FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,9"/>

                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="SecSquircle1" Style="{StaticResource ColorSquircleButtonStyle}" Background="#DBDDE4" Tag="#DBDDE4" Click="SecPresetSquircle_Click"/>
                        <Button x:Name="SecSquircle2" Style="{StaticResource ColorSquircleButtonStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="SecPresetSquircle_Click"/>
                        <Button x:Name="SecSquircle3" Style="{StaticResource ColorSquircleButtonStyle}" Background="#FBBF24" Tag="#FBBF24" Click="SecPresetSquircle_Click"/>
                        <Button x:Name="SecSquircle4" Style="{StaticResource ColorSquircleButtonStyle}" Background="#34D399" Tag="#34D399" Click="SecPresetSquircle_Click"/>
                        <Button x:Name="SecSquircle5" Style="{StaticResource ColorSquircleButtonStyle}" Background="#38BDF8" Tag="#38BDF8" Click="SecPresetSquircle_Click"/>
                        <Button x:Name="SecWheelSquircle" Style="{StaticResource ColorSquircleButtonStyle}" Margin="0" Click="SecWheelSquircle_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 6. Program Icon Colors (Background & Foreground Lines) -->
            <Border Background="{DynamicResource TileBackgroundBrush}"
                    BorderBrush="{DynamicResource TileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Program Icon Colors"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Customizes window, taskbar &amp; tray icon"
                                       FontSize="{DynamicResource FontSizeTiny}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Width="42"
                                Height="42"
                                CornerRadius="10"
                                BorderBrush="{DynamicResource TileBorderBrush}"
                                BorderThickness="1"
                                Margin="12,0,0,0">
                            <Image x:Name="IconLivePreviewImage"
                                   Width="40"
                                   Height="40"
                                   Stretch="Uniform"/>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="IconBgSectionHost" Margin="0,0,0,12">
                        <TextBlock Text="Icon Background Color"
                                   FontSize="{DynamicResource FontSizeTiny}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,7"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="IconBgSquircle1" Style="{StaticResource ColorSquircleButtonStyle}" Background="#18181B" Tag="#18181B" Click="IconBgPresetSquircle_Click"/>
                            <Button x:Name="IconBgSquircle2" Style="{StaticResource ColorSquircleButtonStyle}" Background="#1E3A8A" Tag="#1E3A8A" Click="IconBgPresetSquircle_Click"/>
                            <Button x:Name="IconBgSquircle3" Style="{StaticResource ColorSquircleButtonStyle}" Background="#4C1D95" Tag="#4C1D95" Click="IconBgPresetSquircle_Click"/>
                            <Button x:Name="IconBgSquircle4" Style="{StaticResource ColorSquircleButtonStyle}" Background="#065F46" Tag="#065F46" Click="IconBgPresetSquircle_Click"/>
                            <Button x:Name="IconBgSquircle5" Style="{StaticResource ColorSquircleButtonStyle}" Background="#F4F4F6" Tag="#F4F4F6" Click="IconBgPresetSquircle_Click"/>
                            <Button x:Name="IconBgWheelSquircle" Style="{StaticResource ColorSquircleButtonStyle}" Margin="0" Click="IconBgWheelSquircle_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel x:Name="IconFgSectionHost">
                        <TextBlock Text="Icon Lines Color"
                                   FontSize="{DynamicResource FontSizeTiny}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,7"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="IconFgSquircle1" Style="{StaticResource ColorSquircleButtonStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="IconFgPresetSquircle_Click"/>
                            <Button x:Name="IconFgSquircle2" Style="{StaticResource ColorSquircleButtonStyle}" Background="#18181B" Tag="#18181B" Click="IconFgPresetSquircle_Click"/>
                            <Button x:Name="IconFgSquircle3" Style="{StaticResource ColorSquircleButtonStyle}" Background="#38BDF8" Tag="#38BDF8" Click="IconFgPresetSquircle_Click"/>
                            <Button x:Name="IconFgSquircle4" Style="{StaticResource ColorSquircleButtonStyle}" Background="#4ADE80" Tag="#4ADE80" Click="IconFgPresetSquircle_Click"/>
                            <Button x:Name="IconFgSquircle5" Style="{StaticResource ColorSquircleButtonStyle}" Background="#FBBF24" Tag="#FBBF24" Click="IconFgPresetSquircle_Click"/>
                            <Button x:Name="IconFgWheelSquircle" Style="{StaticResource ColorSquircleButtonStyle}" Margin="0" Click="IconFgWheelSquircle_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 7. Text Size Stepped Dot Slider (50% to 200% in 25% steps; 100% is at the 3rd dot) -->
            <Border Background="{DynamicResource TileBackgroundBrush}"
                    BorderBrush="{DynamicResource TileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Text &amp; UI Scale"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="TextSizePercentLabel"
                                   Text="100%"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Interactive Stepped Track with 7 Dots (50%, 75%, 100%, 125%, 150%, 175%, 200%) -->
                    <Canvas x:Name="SizeSliderCanvas"
                            Height="28"
                            Background="Transparent"
                            Cursor="Hand"
                            SizeChanged="SizeSliderCanvas_SizeChanged"
                            MouseLeftButtonDown="SizeSliderCanvas_MouseLeftButtonDown"
                            MouseMove="SizeSliderCanvas_MouseMove"
                            MouseLeftButtonUp="SizeSliderCanvas_MouseLeftButtonUp">
                        <Border x:Name="SliderTrackBg"
                                Height="6"
                                CornerRadius="3"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                Canvas.Top="11"/>
                        <Border x:Name="SliderTrackFill"
                                Height="6"
                                CornerRadius="3"
                                Background="{DynamicResource AccentBrush}"
                                Canvas.Top="11"/>
                        <Canvas x:Name="SliderDotsLayer"/>
                        <Border x:Name="SliderThumb"
                                Width="18"
                                Height="18"
                                CornerRadius="9"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource WindowBackgroundBrush}"
                                BorderThickness="2.5"
                                Canvas.Top="5"/>
                    </Canvas>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="50%" FontSize="{DynamicResource FontSizeTiny}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="100%" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Text="150%" FontSize="{DynamicResource FontSizeTiny}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="200%" FontSize="{DynamicResource FontSizeTiny}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 8. Contrast & Weight -->
            <Border Background="{DynamicResource TileBackgroundBrush}"
                    BorderBrush="{DynamicResource TileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,11"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Contrast &amp; Weight"
                               FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,7"/>
                    <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="10" Padding="3">
                        <UniformGrid Columns="2">
                            <Button x:Name="HighContrastBtn"
                                    Content="High Contrast"
                                    Style="{StaticResource OptionPillStyle}"
                                    Click="HighContrastBtn_Click"/>
                            <Button x:Name="BoldTextBtn"
                                    Content="Bold Body Text"
                                    Style="{StaticResource OptionPillStyle}"
                                    Click="BoldTextBtn_Click"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Interactive Color Wheel Picker Panel (Dynamically placed directly beneath whichever 6th Color Wheel Squircle is clicked) -->
            <Border x:Name="ColorWheelPickerPanel"
                    Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="14,10"
                    Margin="0,10,0,2"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Circular HSV Color Wheel Canvas -->
                    <Canvas x:Name="WheelCanvas"
                            Grid.Column="0"
                            Width="132"
                            Height="132"
                            Cursor="Cross"
                            MouseLeftButtonDown="WheelCanvas_MouseLeftButtonDown"
                            MouseMove="WheelCanvas_MouseMove"
                            MouseLeftButtonUp="WheelCanvas_MouseLeftButtonUp">
                        <Image x:Name="LargeColorWheelImage" Width="132" Height="132"/>
                        <Ellipse x:Name="WheelSelectorRing"
                                 Width="14"
                                 Height="14"
                                 Stroke="#FFFFFF"
                                 StrokeThickness="2.2"
                                 Fill="Transparent"
                                 IsHitTestVisible="False"
                                 Canvas.Left="59"
                                 Canvas.Top="59">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8" Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>

                    <!-- Right side of Wheel: Target Label + Preview Swatch + Brightness Slider -->
                    <StackPanel Grid.Column="1" Margin="16,4,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="WheelTargetTitleText"
                                   Text="Custom Color"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                            <Border x:Name="WheelPreviewSquircle"
                                    Width="30"
                                    Height="30"
                                    CornerRadius="9"
                                    BorderBrush="{DynamicResource TileBorderBrush}"
                                    BorderThickness="1.5"
                                    Background="#FFFFFF"/>
                            <TextBlock x:Name="WheelHexText"
                                       Text="#FFFFFF"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="Brightness"
                                   FontSize="{DynamicResource FontSizeTiny}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,4"/>
                        <Slider x:Name="WheelBrightnessSlider"
                                Minimum="0.08"
                                Maximum="1.0"
                                Value="1.0"
                                ValueChanged="WheelBrightnessSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Actions -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Reset to Defaults"
                        Style="{StaticResource OptionPillStyle}"
                        Click="ResetDefaults_Click"/>

                <Button Grid.Column="2"
                        Content="Done"
                        Style="{StaticResource OptionPillStyle}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource OnAccentTextBrush}"
                        Padding="18,7"
                        Click="DoneButton_Click"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
